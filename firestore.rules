rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // User profile and backups
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /backups/{backupId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Real-Time P2P Transfer Rooms across any device / phone
    match /transfer_rooms/{pinCode} {
      allow read, create, update, delete: if true;
    }

    // Active Mesh Network Peer Beacons for live local discovery
    match /active_mesh_peers/{peerId} {
      allow read, create, update, delete: if true;
    }
  }
}
