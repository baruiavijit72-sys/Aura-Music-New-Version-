import React, { useId } from 'react';

export interface AuraLogoProps {
  size?: number | string;
  className?: string;
  variant?: 'full' | 'emblem' | 'vinyl-label' | 'badge';
  glow?: boolean;
  animated?: boolean;
  onClick?: () => void;
  id?: string;
}

/**
 * Signature Aura Music Official Logo (Concept #1 Master Edition)
 * Inspired by the user-selected flagship design:
 * - Circular Gradient Aura Ring (Cyan/Sky-Blue transitioning to Vivid Purple/Magenta)
 * - 7 Dynamic Equalizer Audio Spectrum Bars (Cyan, Teal, Emerald, White Core, Magenta, Purple, Violet)
 * - Premium Wordmark: "AUR" in crisp geometric white + 3D Folded Ruby Red Ribbon 'A'
 * - Luxury Golden Subtitle: "MUSIC & MEDIA"
 * - 60fps Hardware-Accelerated Equalizer Bounce, Ring Pulse, and Red 'A' Specular Gleam
 */
export const AuraLogo: React.FC<AuraLogoProps> = ({
  size = 64,
  className = '',
  variant = 'full',
  glow = true,
  animated = true,
  onClick,
  id,
}) => {
  const rawUid = useId();
  const uid = rawUid.replace(/[^a-zA-Z0-9]/g, '_');

  const gradRing = `aura_ring_grad_${uid}`;
  const gradWhiteBar = `aura_white_bar_${uid}`;
  const gradRedA = `aura_red_a_grad_${uid}`;
  const gradRedDark = `aura_red_dark_grad_${uid}`;
  const gradRedFold = `aura_red_fold_grad_${uid}`;
  const gradGoldText = `aura_gold_text_${uid}`;
  const gradCosmicInner = `aura_cosmic_inner_${uid}`;
  const filterBloom = `aura_bloom_filter_${uid}`;
  const filterGleam = `aura_gleam_filter_${uid}`;

  const pixelSize = typeof size === 'number' ? `${size}px` : size;

  return (
    <div
      id={id}
      onClick={onClick}
      style={{ width: pixelSize, height: pixelSize }}
      className={`relative inline-flex items-center justify-center flex-shrink-0 select-none ${
        onClick ? 'cursor-pointer' : ''
      } ${className}`}
    >
      {/* Ambient Neon Volumetric Bloom */}
      {glow && (
        <div
          className={`absolute -inset-2.5 rounded-full blur-xl opacity-60 pointer-events-none transition-all duration-700 ${
            animated ? 'animate-pulse' : ''
          }`}
          style={{
            background:
              'radial-gradient(circle, rgba(0,242,254,0.35) 0%, rgba(168,85,247,0.3) 55%, transparent 75%)',
          }}
        />
      )}

      <svg
        viewBox={variant === 'full' ? '0 0 120 125' : '0 0 100 100'}
        className="w-full h-full relative z-10 overflow-visible drop-shadow-2xl"
        fill="none"
        xmlns="http://www.w3.org/2000/svg"
      >
        <defs>
          <style>{`
            /* Equalizer 7-Bar Rhythmic Spectrum Bounces */
            @keyframes eqBounce1_${uid} {
              0%, 100% { transform: scaleY(0.42); opacity: 0.85; }
              50% { transform: scaleY(1.35); opacity: 1; }
            }
            @keyframes eqBounce2_${uid} {
              0%, 100% { transform: scaleY(0.55); opacity: 0.9; }
              50% { transform: scaleY(1.22); opacity: 1; }
            }
            @keyframes eqBounce3_${uid} {
              0%, 100% { transform: scaleY(0.62); opacity: 0.92; }
              50% { transform: scaleY(1.18); opacity: 1; }
            }
            @keyframes eqBounce4_${uid} {
              0%, 100% { transform: scaleY(0.68); opacity: 0.95; }
              50% { transform: scaleY(1.26); opacity: 1; filter: drop-shadow(0 0 6px #ffffff); }
            }
            @keyframes eqBounce5_${uid} {
              0%, 100% { transform: scaleY(0.52); opacity: 0.92; }
              50% { transform: scaleY(1.28); opacity: 1; }
            }
            @keyframes eqBounce6_${uid} {
              0%, 100% { transform: scaleY(0.48); opacity: 0.88; }
              50% { transform: scaleY(1.25); opacity: 1; }
            }
            @keyframes eqBounce7_${uid} {
              0%, 100% { transform: scaleY(0.38); opacity: 0.85; }
              50% { transform: scaleY(1.4); opacity: 1; }
            }

            /* Aura Ring Breathing Glow & Subtle Rotation */
            @keyframes ringPulse_${uid} {
              0%, 100% { filter: drop-shadow(0 0 4px rgba(0, 242, 254, 0.4)); }
              50% { filter: drop-shadow(0 0 10px rgba(217, 70, 239, 0.6)); }
            }

            /* Folded Red 'A' Specular Shine Gleam */
            @keyframes redGleamSweep_${uid} {
              0%, 10% { opacity: 0; transform: translateX(-18px) skewX(-20deg); }
              35% { opacity: 0.95; }
              60%, 100% { opacity: 0; transform: translateX(24px) skewX(-20deg); }
            }

            /* Corner Stardust Twinkle */
            @keyframes cornerTwinkle_${uid} {
              0%, 100% { opacity: 0.25; transform: scale(0.75); }
              50% { opacity: 1; transform: scale(1.3); }
            }

            .anim-bar-1_${uid} { animation: eqBounce1_${uid} 1.15s ease-in-out infinite; }
            .anim-bar-2_${uid} { animation: eqBounce2_${uid} 0.88s ease-in-out infinite 0.1s; }
            .anim-bar-3_${uid} { animation: eqBounce3_${uid} 1.32s ease-in-out infinite 0.2s; }
            .anim-bar-4_${uid} { animation: eqBounce4_${uid} 0.76s ease-in-out infinite 0.05s; }
            .anim-bar-5_${uid} { animation: eqBounce5_${uid} 0.96s ease-in-out infinite 0.15s; }
            .anim-bar-6_${uid} { animation: eqBounce6_${uid} 1.22s ease-in-out infinite 0.25s; }
            .anim-bar-7_${uid} { animation: eqBounce7_${uid} 0.92s ease-in-out infinite 0.08s; }

            .anim-ring_${uid} { animation: ringPulse_${uid} 3s ease-in-out infinite; }
            .anim-red-gleam_${uid} { animation: redGleamSweep_${uid} 3.4s ease-in-out infinite; }
            .anim-twinkle_${uid} { animation: cornerTwinkle_${uid} 2.2s ease-in-out infinite; }
          `}</style>

          {/* 1. Aura Outer Gradient Ring (Cyan to Sky to Purple to Pink) */}
          <linearGradient id={gradRing} x1="10%" y1="10%" x2="90%" y2="90%">
            <stop offset="0%" stopColor="#00f2fe" />
            <stop offset="28%" stopColor="#38bdf8" />
            <stop offset="60%" stopColor="#818cf8" />
            <stop offset="82%" stopColor="#c084fc" />
            <stop offset="100%" stopColor="#ec4899" />
          </linearGradient>

          {/* 2. Pure White Core Bar Gradient with Specular Light */}
          <linearGradient id={gradWhiteBar} x1="0%" y1="0%" x2="0%" y2="100%">
            <stop offset="0%" stopColor="#ffffff" />
            <stop offset="45%" stopColor="#f8fafc" />
            <stop offset="100%" stopColor="#cbd5e1" />
          </linearGradient>

          {/* 3. Deep Obsidian / Space Canvas Inner Fill */}
          <radialGradient id={gradCosmicInner} cx="50%" cy="50%" r="50%">
            <stop offset="0%" stopColor="#0a1226" />
            <stop offset="65%" stopColor="#040814" />
            <stop offset="100%" stopColor="#01030a" />
          </radialGradient>

          {/* 4. Folded Red 'A' Ribbon Gradients */}
          <linearGradient id={gradRedA} x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" stopColor="#f87171" />
            <stop offset="35%" stopColor="#ef4444" />
            <stop offset="80%" stopColor="#dc2626" />
            <stop offset="100%" stopColor="#991b1b" />
          </linearGradient>

          <linearGradient id={gradRedDark} x1="0%" y1="0%" x2="0%" y2="100%">
            <stop offset="0%" stopColor="#b91c1c" />
            <stop offset="100%" stopColor="#7f1d1d" />
          </linearGradient>

          <linearGradient id={gradRedFold} x1="0%" y1="0%" x2="100%" y2="0%">
            <stop offset="0%" stopColor="#991b1b" />
            <stop offset="50%" stopColor="#ef4444" />
            <stop offset="100%" stopColor="#b91c1c" />
          </linearGradient>

          {/* 5. Luxury Gold Typography Gradient */}
          <linearGradient id={gradGoldText} x1="0%" y1="0%" x2="100%" y2="0%">
            <stop offset="0%" stopColor="#fde68a" />
            <stop offset="50%" stopColor="#fbbf24" />
            <stop offset="100%" stopColor="#f59e0b" />
          </linearGradient>

          {/* 6. Soft Bloom Filter */}
          <filter id={filterBloom} x="-20%" y="-20%" width="140%" height="140%">
            <feGaussianBlur in="SourceGraphic" stdDeviation="1.8" result="blur" />
            <feMerge>
              <feMergeNode in="blur" />
              <feMergeNode in="SourceGraphic" />
            </feMerge>
          </filter>

          {/* 7. Specular Gleam Filter */}
          <filter id={filterGleam} x="-30%" y="-30%" width="160%" height="160%">
            <feGaussianBlur in="SourceGraphic" stdDeviation="1" result="blur" />
            <feMerge>
              <feMergeNode in="blur" />
              <feMergeNode in="SourceGraphic" />
            </feMerge>
          </filter>
        </defs>

        {/* ---------------------------------------------------- */}
        {/* VIEW 1: FULL LOCKUP (Circle + AURA + MUSIC & MEDIA)  */}
        {/* ---------------------------------------------------- */}
        {variant === 'full' && (
          <g>
            {/* Top Circular Emblem Container */}
            <g transform="translate(10, 0)">
              {/* Outer Glow Halo Ring */}
              <circle
                cx="50"
                cy="38"
                r="33"
                stroke={`url(#${gradRing})`}
                strokeWidth="3.4"
                fill={`url(#${gradCosmicInner})`}
                className={animated ? `anim-ring_${uid}` : ''}
              />

              {/* Inner Fine Specular Highlight */}
              <circle
                cx="50"
                cy="38"
                r="30.5"
                stroke="#ffffff"
                strokeWidth="0.5"
                strokeOpacity="0.25"
                fill="none"
              />

              {/* Central Audio Spectrum 7 Equalizer Bars */}
              <g id="equalizer-bars-full" filter={`url(#${filterBloom})`}>
                {/* Bar 1 (Leftmost, Cyan) */}
                <g style={{ transformOrigin: '29px 38px' }} className={animated ? `anim-bar-1_${uid}` : ''}>
                  <rect x="27.4" y="27" width="3.2" height="22" rx="1.6" fill="#00f2fe" />
                </g>

                {/* Bar 2 (Cyan-Teal) */}
                <g style={{ transformOrigin: '36px 38px' }} className={animated ? `anim-bar-2_${uid}` : ''}>
                  <rect x="34.4" y="22" width="3.2" height="32" rx="1.6" fill="#00d8f6" />
                </g>

                {/* Bar 3 (Bright Mint / Emerald) */}
                <g style={{ transformOrigin: '43px 38px' }} className={animated ? `anim-bar-3_${uid}` : ''}>
                  <rect x="41.4" y="17" width="3.2" height="42" rx="1.6" fill="#10b981" />
                </g>

                {/* Bar 4 (Center Tallest, Pure Luminous White) */}
                <g style={{ transformOrigin: '50px 38px' }} className={animated ? `anim-bar-4_${uid}` : ''}>
                  <rect x="48.3" y="12" width="3.4" height="52" rx="1.7" fill={`url(#${gradWhiteBar})`} />
                </g>

                {/* Bar 5 (Vivid Magenta / Pink) */}
                <g style={{ transformOrigin: '57px 38px' }} className={animated ? `anim-bar-5_${uid}` : ''}>
                  <rect x="55.4" y="18" width="3.2" height="40" rx="1.6" fill="#d946ef" />
                </g>

                {/* Bar 6 (Rich Purple) */}
                <g style={{ transformOrigin: '64px 38px' }} className={animated ? `anim-bar-6_${uid}` : ''}>
                  <rect x="62.4" y="23" width="3.2" height="30" rx="1.6" fill="#a855f7" />
                </g>

                {/* Bar 7 (Rightmost, Violet) */}
                <g style={{ transformOrigin: '71px 38px' }} className={animated ? `anim-bar-7_${uid}` : ''}>
                  <rect x="69.4" y="28" width="3.2" height="20" rx="1.6" fill="#818cf8" />
                </g>
              </g>
            </g>

            {/* Middle Wordmark: "AURA" with mathematical vector glyphs - guaranteed zero device drift */}
            <g id="aura-wordmark-vector" filter={`url(#${filterBloom})`}>
              {/* Drop Shadow for the letters */}
              <g fill="#000000" opacity="0.6" transform="translate(0, 1.5)">
                {/* A */}
                <path d="M 34.8 82 L 42.5 99 L 38.6 99 L 36.8 95 L 32.8 95 L 31 99 L 27 99 Z M 34.8 86.8 L 36 91.8 L 33.6 91.8 Z" />
                {/* U */}
                <path d="M 45.5 82 L 49 82 L 49 92.5 C 49 94.6 50.1 95.8 51.5 95.8 C 52.9 95.8 54 94.6 54 92.5 L 54 82 L 57.5 82 L 57.5 93 C 57.5 97.2 55 99.4 51.5 99.4 C 48 99.4 45.5 97.2 45.5 93 Z" />
                {/* R */}
                <path d="M 60.5 82 L 68.2 82 C 71.8 82 73.8 84 73.8 87.2 C 73.8 89.8 72 91.4 69.4 91.8 L 74 99 L 69.6 99 L 65.8 92.4 L 64 92.4 L 64 99 L 60.5 99 Z M 64 85.4 L 64 89.2 L 67.8 89.2 C 69.4 89.2 70.2 88.4 70.2 87.3 C 70.2 86.2 69.4 85.4 67.8 85.4 Z" />
              </g>

              {/* 1. First Letter 'A' (Crisp Geometric White) */}
              <path
                d="M 34.8 82 
                   L 42.5 99 
                   L 38.6 99 
                   L 36.8 95 
                   L 32.8 95 
                   L 31 99 
                   L 27 99 Z 
                   M 34.8 86.8 
                   L 36 91.8 
                   L 33.6 91.8 Z"
                fill="#ffffff"
              />

              {/* 2. Second Letter 'U' (Crisp Geometric White) */}
              <path
                d="M 45.5 82 
                   L 49 82 
                   L 49 92.5 
                   C 49 94.6, 50.1 95.8, 51.5 95.8 
                   C 52.9 95.8, 54 94.6, 54 92.5 
                   L 54 82 
                   L 57.5 82 
                   L 57.5 93 
                   C 57.5 97.2, 55 99.4, 51.5 99.4 
                   C 48 99.4, 45.5 97.2, 45.5 93 Z"
                fill="#ffffff"
              />

              {/* 3. Third Letter 'R' (Crisp Geometric White) */}
              <path
                d="M 60.5 82 
                   L 68.2 82 
                   C 71.8 82, 73.8 84, 73.8 87.2 
                   C 73.8 89.8, 72 91.4, 69.4 91.8 
                   L 74 99 
                   L 69.6 99 
                   L 65.8 92.4 
                   L 64 92.4 
                   L 64 99 
                   L 60.5 99 Z 
                   M 64 85.4 
                   L 64 89.2 
                   L 67.8 89.2 
                   C 69.4 89.2, 70.2 88.4, 70.2 87.3 
                   C 70.2 86.2, 69.4 85.4, 67.8 85.4 Z"
                fill="#ffffff"
              />

              {/* 4. Fourth Letter 'A' (Iconic 3D Folded Ruby Red Ribbon) - Sits with exact natural kerning */}
              <g id="folded-red-a" transform="translate(76.5, 80)">
                {/* Left Slanted Leg (Deep crimson shadow fold) */}
                <path
                  d="M 8.2 2 
                     L 0.5 19 
                     L 4.5 19 
                     L 7.8 12.8 
                     L 10.8 5.8 Z"
                  fill={`url(#${gradRedDark})`}
                />

                {/* Right Slanted Leg & Folded Apex (Vibrant ruby red facet) */}
                <path
                  d="M 8.2 2 
                     L 15.8 19 
                     L 11.6 19 
                     L 9.6 13.5 
                     L 7.6 7 Z"
                  fill={`url(#${gradRedA})`}
                />

                {/* 3D Folded Front Ribbon Crossbar */}
                <path
                  d="M 3.2 14.2 
                     C 5.2 12.4, 10.2 11.2, 13.4 14.2 
                     L 12.2 16.8 
                     C 9.8 14.8, 5.6 15.2, 4.2 16.8 Z"
                  fill={`url(#${gradRedFold})`}
                />

                {/* Specular Shine Sweep across the Red Ribbon */}
                {animated && (
                  <g className={`anim-red-gleam_${uid}`} opacity="0.85">
                    <line x1="3" y1="2" x2="12" y2="18" stroke="#ffffff" strokeWidth="1.6" strokeLinecap="round" />
                  </g>
                )}
              </g>
            </g>

            {/* Bottom Subtitle: "MUSIC & MEDIA" (Warm Golden Luxury Tracked Text) */}
            <text
              x="60"
              y="114"
              textAnchor="middle"
              fill={`url(#${gradGoldText})`}
              fontFamily="'Montserrat', 'Inter', -apple-system, sans-serif"
              fontSize="6.8"
              fontWeight="800"
              letterSpacing="2.8"
              style={{ filter: 'drop-shadow(0 1px 3px rgba(0,0,0,0.7))' }}
            >
              MUSIC &amp; MEDIA
            </text>

            {/* Bottom-Right Corner Diamond Star Sparkle (as in user reference) */}
            <g
              transform="translate(108, 108)"
              className={animated ? `anim-twinkle_${uid}` : ''}
              style={{ transformOrigin: '108px 108px' }}
            >
              <polygon points="0,-3 1,-1 3,0 1,1 0,3 -1,1 -3,0 -1,-1" fill="#cbd5e1" opacity="0.9" />
              <circle cx="0" cy="0" r="0.6" fill="#ffffff" />
            </g>
          </g>
        )}

        {/* ---------------------------------------------------- */}
        {/* VIEW 2: EMBLEM ONLY (Circle + 7 Equalizer Bars)      */}
        {/* ---------------------------------------------------- */}
        {(variant === 'emblem' || variant === 'badge') && (
          <g>
            {/* Outer Aura Ring */}
            <circle
              cx="50"
              cy="50"
              r="44"
              stroke={`url(#${gradRing})`}
              strokeWidth="4.2"
              fill={`url(#${gradCosmicInner})`}
              className={animated ? `anim-ring_${uid}` : ''}
            />

            {/* Precision Inner Specular Edge */}
            <circle
              cx="50"
              cy="50"
              r="40.5"
              stroke="#ffffff"
              strokeWidth="0.75"
              strokeOpacity="0.25"
              fill="none"
            />

            {/* 7 Equalizer Spectrum Bars */}
            <g id="equalizer-bars-emblem" filter={`url(#${filterBloom})`}>
              {/* Bar 1 (Leftmost Cyan) */}
              <g style={{ transformOrigin: '24px 50px' }} className={animated ? `anim-bar-1_${uid}` : ''}>
                <rect x="21.8" y="36" width="4.4" height="28" rx="2.2" fill="#00f2fe" />
              </g>

              {/* Bar 2 (Cyan-Teal) */}
              <g style={{ transformOrigin: '33px 50px' }} className={animated ? `anim-bar-2_${uid}` : ''}>
                <rect x="30.8" y="29" width="4.4" height="42" rx="2.2" fill="#00d8f6" />
              </g>

              {/* Bar 3 (Mint / Emerald) */}
              <g style={{ transformOrigin: '41.5px 50px' }} className={animated ? `anim-bar-3_${uid}` : ''}>
                <rect x="39.3" y="22" width="4.4" height="56" rx="2.2" fill="#10b981" />
              </g>

              {/* Bar 4 (Center Tallest, Pure Glowing White) */}
              <g style={{ transformOrigin: '50px 50px' }} className={animated ? `anim-bar-4_${uid}` : ''}>
                <rect x="47.7" y="15" width="4.6" height="70" rx="2.3" fill={`url(#${gradWhiteBar})`} />
              </g>

              {/* Bar 5 (Vivid Magenta) */}
              <g style={{ transformOrigin: '58.5px 50px' }} className={animated ? `anim-bar-5_${uid}` : ''}>
                <rect x="56.3" y="23" width="4.4" height="54" rx="2.2" fill="#d946ef" />
              </g>

              {/* Bar 6 (Purple) */}
              <g style={{ transformOrigin: '67px 50px' }} className={animated ? `anim-bar-6_${uid}` : ''}>
                <rect x="64.8" y="30" width="4.4" height="40" rx="2.2" fill="#a855f7" />
              </g>

              {/* Bar 7 (Rightmost Violet) */}
              <g style={{ transformOrigin: '76px 50px' }} className={animated ? `anim-bar-7_${uid}` : ''}>
                <rect x="73.8" y="37" width="4.4" height="26" rx="2.2" fill="#818cf8" />
              </g>
            </g>
          </g>
        )}

        {/* ---------------------------------------------------- */}
        {/* VIEW 3: VINYL-LABEL (Tailored for Turntable Center)  */}
        {/* ---------------------------------------------------- */}
        {variant === 'vinyl-label' && (
          <g>
            {/* Deep Vinyl Center Core */}
            <circle cx="50" cy="50" r="48" fill={`url(#${gradCosmicInner})`} />

            {/* Outer Aura Ring */}
            <circle
              cx="50"
              cy="50"
              r="45"
              stroke={`url(#${gradRing})`}
              strokeWidth="2.8"
              fill="none"
              className={animated ? `anim-ring_${uid}` : ''}
            />

            {/* Concentric Vinyl Micro-Grooves */}
            <circle cx="50" cy="50" r="41" stroke="#ffffff" strokeWidth="0.4" opacity="0.2" fill="none" />
            <circle cx="50" cy="50" r="37" stroke="#38bdf8" strokeWidth="0.5" strokeDasharray="3 3" opacity="0.3" fill="none" />
            <circle cx="50" cy="50" r="14" stroke="#ffffff" strokeWidth="0.4" opacity="0.2" fill="none" />

            {/* 7 Equalizer Bars Scaled for Center Vinyl Label */}
            <g id="equalizer-bars-vinyl" transform="scale(0.72) translate(19.5, 19.5)" filter={`url(#${filterBloom})`}>
              {/* Bar 1 */}
              <g style={{ transformOrigin: '24px 50px' }} className={animated ? `anim-bar-1_${uid}` : ''}>
                <rect x="21.8" y="36" width="4.4" height="28" rx="2.2" fill="#00f2fe" />
              </g>
              {/* Bar 2 */}
              <g style={{ transformOrigin: '33px 50px' }} className={animated ? `anim-bar-2_${uid}` : ''}>
                <rect x="30.8" y="29" width="4.4" height="42" rx="2.2" fill="#00d8f6" />
              </g>
              {/* Bar 3 */}
              <g style={{ transformOrigin: '41.5px 50px' }} className={animated ? `anim-bar-3_${uid}` : ''}>
                <rect x="39.3" y="22" width="4.4" height="56" rx="2.2" fill="#10b981" />
              </g>
              {/* Bar 4 */}
              <g style={{ transformOrigin: '50px 50px' }} className={animated ? `anim-bar-4_${uid}` : ''}>
                <rect x="47.7" y="15" width="4.6" height="70" rx="2.3" fill={`url(#${gradWhiteBar})`} />
              </g>
              {/* Bar 5 */}
              <g style={{ transformOrigin: '58.5px 50px' }} className={animated ? `anim-bar-5_${uid}` : ''}>
                <rect x="56.3" y="23" width="4.4" height="54" rx="2.2" fill="#d946ef" />
              </g>
              {/* Bar 6 */}
              <g style={{ transformOrigin: '67px 50px' }} className={animated ? `anim-bar-6_${uid}` : ''}>
                <rect x="64.8" y="30" width="4.4" height="40" rx="2.2" fill="#a855f7" />
              </g>
              {/* Bar 7 */}
              <g style={{ transformOrigin: '76px 50px' }} className={animated ? `anim-bar-7_${uid}` : ''}>
                <rect x="73.8" y="37" width="4.4" height="26" rx="2.2" fill="#818cf8" />
              </g>
            </g>

            {/* Turntable Spindle Hole */}
            <circle cx="50" cy="50" r="3.2" fill="#000000" stroke="#38bdf8" strokeWidth="0.8" />
          </g>
        )}
      </svg>
    </div>
  );
};

export default AuraLogo;
